import numpy as np
class TreeAncestor:
    def __init__(self, n: int, parent: List[int]):

        col=int(log2(n)+1)
        self.table=np.full((n,col),-1)
        self.table[:,0]=parent
        for j in range(1,col):
            for i in range(1,n):
                if self.table[i,j-1]<0 or self.table[self.table[i,j-1],j-1]<0:
                    continue
                self.table[i,j]=self.table[self.table[i,j-1],j-1]

    def getKthAncestor(self, node: int, k: int) -> int:
        jump=[]
        while k!=0:
            tem=int(log2(k))
            k-=pow(2,tem)
            jump.append(tem)
        cur=node
        for i in jump:
            cur=self.table[cur,i]
            if cur<0:
                return  -1
        return int(cur)


